# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# MUSIC_API_KEY: Optional external AI Music Generation Provider (e.g. Suno, Udio, MusicGen)
MUSIC_API_KEY=MY_MUSIC_API_KEY

# MUSIC_API_URL: Provider endpoint URL (e.g. https://api.suno.ai/v1 or custom music endpoint)
MUSIC_API_URL=https://api.divsong.ai/v1

# Payment Gateway Configuration
PAYSTACK_PUBLIC_KEY=pk_test_divsongai_paystack
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-divsongai
STRIPE_PUBLISHABLE_KEY=pk_test_divsongai_stripe
